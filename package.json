{
  "name": "tipjar",
  "version": "2.0.0",
  "description": "A small floating tip button for Ko-fi, Buy Me a Coffee, GitHub Sponsors or any link. Zero dependencies, works under a strict CSP.",
  "keywords": [
    "tip",
    "donate",
    "support",
    "ko-fi",
    "sponsor",
    "button",
    "floating-action-button",
    "svg-icons"
  ],
  "license": "MIT",
  "author": "Matt Black (https://mattblack.space)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtblck/tipjar.git"
  },
  "bugs": "https://github.com/mtblck/tipjar/issues",
  "funding": "https://ko-fi.com/mtblck",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "docs": "npm run build && npm --prefix tools/api-docs ci --ignore-scripts && npm --prefix tools/api-docs run build",
    "check:package": "npm run build && node scripts/check-package.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./style.css",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.64.1",
    "happy-dom": "^21.0.4",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
  "homepage": "https://mattblack.space/tools/tipjar/"
}
